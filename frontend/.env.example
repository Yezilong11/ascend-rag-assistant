# ============================================================================
# Ascend RAG Assistant - 前端环境变量配置
# ============================================================================
# 本文件配置前端连接的后端服务地址
# 根据部署环境复制并修改为对应的值
# ============================================================================

# API 服务地址（Python FastAPI）
VITE_API_BASE_URL=http://localhost:8000

# RSS 服务地址（Go 微服务）
VITE_RSS_SERVICE_URL=http://localhost:8081

# 是否启用调试模式
VITE_DEBUG=false
