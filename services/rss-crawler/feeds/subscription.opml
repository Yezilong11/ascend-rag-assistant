      <outline type="rss" text="Soren游戏资讯" title="Soren游戏资讯" xmlUrl="https://soren.com/zh-CN/news/delta-force--1/feed/" htmlUrl="https://soren.com/zh-CN/news/delta-force--1/" description="三角洲行动每日资讯"/>
    </outline>

  </body>
